{
  "schemaVersion": 1,
  "widgets": [
    {
      "id": "hydration_tracker",
      "name": "Hydration",
      "description": "A small daily water counter with a progress bar.",
      "version": 1,
      "icon": "💧",
      "definition": {
        "id": "hydration_tracker",
        "title": "Hydration",
        "subtitle": "Daily water",
        "style": "NOTHING_MINIMAL",
        "state": {
          "count": "3",
          "goal": "8"
        },
        "elements": [
          {
            "type": "row",
            "alignment": "SPACE_BETWEEN",
            "children": [
              {
                "type": "text",
                "text": "{count} / {goal} glasses",
                "size": "BIG_NUMBER",
                "font": "SYSTEM",
                "color": "ACCENT"
              },
              {
                "type": "row",
                "spacingDp": 8,
                "alignment": "END",
                "children": [
                  {
                    "type": "button",
                    "label": "−",
                    "action": "DECREMENT",
                    "targetVar": "count",
                    "param": "1"
                  },
                  {
                    "type": "button",
                    "label": "+",
                    "action": "INCREMENT",
                    "targetVar": "count",
                    "param": "1"
                  }
                ]
              }
            ]
          },
          {
            "type": "spacer",
            "heightDp": 8
          },
          {
            "type": "progress_bar",
            "currentVar": "count",
            "maxVarOrVal": "goal",
            "color": "ACCENT"
          }
        ]
      }
    },
    {
      "id": "carl_pei_big_eyes",
      "name": "Big Eyes",
      "description": "Interactive expressive eyes widget inspired by Nothing Playground.",
      "version": 1,
      "icon": "👀",
      "definition": {
        "id": "carl_pei_big_eyes",
        "title": "Big Eyes",
        "subtitle": "Nothing Playground",
        "style": "NOTHING_MINIMAL",
        "state": {
          "eyes": "●   ●"
        },
        "elements": [
          {
            "type": "spacer",
            "heightDp": 8
          },
          {
            "type": "text",
            "text": "{eyes}",
            "size": "HERO",
            "font": "DOT_MATRIX",
            "color": "DEFAULT",
            "alignment": "CENTER"
          },
          {
            "type": "spacer",
            "heightDp": 4
          },
          {
            "type": "text",
            "text": "TAP TO ANIMATE",
            "size": "LABEL",
            "font": "DOT_MATRIX",
            "color": "MUTED",
            "alignment": "CENTER"
          },
          {
            "type": "spacer",
            "heightDp": 12
          },
          {
            "type": "row",
            "alignment": "SPACE_BETWEEN",
            "children": [
              {
                "type": "button",
                "label": "Blink",
                "action": "SET_VALUE",
                "targetVar": "eyes",
                "param": "—   —"
              },
              {
                "type": "button",
                "label": "Wink",
                "action": "SET_VALUE",
                "targetVar": "eyes",
                "param": "●   —"
              },
              {
                "type": "button",
                "label": "Squint",
                "action": "SET_VALUE",
                "targetVar": "eyes",
                "param": "^   ^"
              },
              {
                "type": "button",
                "label": "Look",
                "action": "SET_VALUE",
                "targetVar": "eyes",
                "param": "◀   ◀"
              }
            ]
          },
          {
            "type": "spacer",
            "heightDp": 8
          },
          {
            "type": "row",
            "alignment": "SPACE_BETWEEN",
            "children": [
              {
                "type": "button",
                "label": "Surprise",
                "action": "SET_VALUE",
                "targetVar": "eyes",
                "param": "◉   ◉"
              },
              {
                "type": "button",
                "label": "Sleep",
                "action": "SET_VALUE",
                "targetVar": "eyes",
                "param": "◡   ◡"
              },
              {
                "type": "button",
                "label": "Awake",
                "action": "SET_VALUE",
                "targetVar": "eyes",
                "param": "●   ●"
              },
              {
                "type": "button",
                "label": "Reset",
                "action": "RESET",
                "targetVar": "eyes",
                "param": "●   ●"
              }
            ]
          }
        ]
      }
    }
  ]
}
